# Copy to .env and configure your cloud database credentials
DB_ENGINE=auto
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=flight_fare_db
MYSQL_URI=mysql+pymysql://root:@localhost:3306/flight_fare_db
FARELENS_JWT_SECRET=change-this-secret-in-production
